APP_ENV=qa
DJANGO_SETTINGS_MODULE=config.settings.qa
DJANGO_SECRET_KEY=replace-with-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=api-qa.example.org,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://YOUR-ACCOUNT.github.io
CSRF_TRUSTED_ORIGINS=https://api-qa.example.org
POSTGRES_DB=talentsmart_qa
POSTGRES_USER=talentsmart
POSTGRES_PASSWORD=replace-with-random-secret
MINIO_ROOT_USER=talentsmart-root
MINIO_ROOT_PASSWORD=replace-with-random-secret
MINIO_ACCESS_KEY=talentsmart-app
MINIO_SECRET_KEY=replace-with-random-secret
MINIO_BUCKET=talentsmart-qa
RFID_API_KEY=replace-with-random-secret
TALENTOSITO_SERVICE_KEY=replace-with-random-secret
TALENTOSITO_DEVICE_KEY=replace-with-random-secret
GROQ_API_KEY=
QA_HTTP_PORT=9083
# CI overrides these with the commit-specific images.
BACKEND_IMAGE=ghcr.io/YOUR-ACCOUNT/et-talent-smart-backend:COMMIT
PAGINA_CONTROL_IMAGE=ghcr.io/YOUR-ACCOUNT/et-talent-smart-pagina-control:COMMIT
TALENTOSITO_IMAGE=ghcr.io/YOUR-ACCOUNT/et-talent-smart-talentosito:COMMIT
MINIO_IMAGE=ghcr.io/YOUR-ACCOUNT/et-talent-smart-minio:COMMIT
MINIO_MC_IMAGE=ghcr.io/YOUR-ACCOUNT/et-talent-smart-minio-mc:COMMIT
